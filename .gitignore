# ==============================================================================
# Lapang.id - Global Repository .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Directories
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# AI Agent & Workspace Local Data
.agents/
.gemini/

# Dependency Directories
node_modules/
jspm_packages/
.pnp
.pnp.*

# Build & Compiled Outputs
dist/
build/
out/
.next/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets (Keep .env.example safe)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Testing & Coverage Artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local Storage, Uploads & Temporary Dumps
uploads/
storage/
temp/
tmp/
*.tmp
*.temp
*.sql
*.sqlite
*.dump

# Cache
.cache/
.turbo/
.eslintcache
