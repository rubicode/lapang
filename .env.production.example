# ==============================================================================
# Lapang.id - Template Konfigurasi Environment Server Production (AWS EC2)
# Simpan file ini sebagai `.env` di folder `/home/ubuntu/lapang/.env` pada server EC2
# ==============================================================================

NODE_ENV=production

# --- PostgreSQL + PostGIS Container ---
DB_NAME=lapang_db
DB_USER=postgres
DB_PASS=lapang_db_secure_password_random_2026

# --- MinIO S3 Object Storage Container ---
MINIO_ACCESS_KEY=minio_lapang_admin
MINIO_SECRET_KEY=minio_secure_secret_key_random_2026

# --- Midtrans Payment Gateway ---
MIDTRANS_SERVER_KEY=Mid-server-your-key-here
MIDTRANS_CLIENT_KEY=Mid-client-your-key-here
MIDTRANS_IS_PRODUCTION=false

# --- Authentication & CORS ---
ALLOWED_ORIGINS=https://domain-anda.com,http://ip-ec2-anda
JWT_SECRET=super_strong_random_jwt_secret_key_minimum_32_characters_here

# --- Frontend Next.js Public Endpoint ---
NEXT_PUBLIC_API_URL=/api/v1
