# ==============================================================================
# Lapang.id - Frontend Specific .gitignore (Next.js / TypeScript / Playwright)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs
/.next/
/out/
/build

# Playwright & Testing Outputs
/coverage
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment Files
.env*
!.env.example

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.turbo/
.vercel

# OS Files
.DS_Store
*.pem
Thumbs.db
