# ==============================================================================
# Lapang.id - Backend Specific .gitignore (Express.js / Sequelize / PostgreSQL)
# ==============================================================================

# Dependencies
node_modules/

# Environment Variables & Secrets (Keep .env.example safe)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Test Coverage & NYC Output
coverage/
.nyc_output/

# Temporary Local File Uploads & Object Storage Cache
uploads/
temp/
tmp/
storage/

# Local Database Dumps & SQLite files
*.sql
*.sqlite
*.sqlite3
*.dump

# OS files
.DS_Store
Thumbs.db
