{
  "name": "lapang-backend",
  "version": "1.0.0",
  "description": "Backend API untuk Platform Pengolahan & Reservasi Lapangan Olahraga Se-Indonesia (Lapang.id)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "test": "node --test tests/**/*.test.js",
    "seed": "node seeders/seed.js"
  },
  "keywords": [
    "express",
    "sequelize",
    "minio",
    "lapang",
    "sports-venue",
    "indonesia"
  ],
  "author": "LapangID Engineering",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^19.5.0",
    "helmet": "^8.0.0",
    "minio": "^8.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}
